// run():   a normal method call, runs on the CURRENT thread (no new thread).
// start(): creates a NEW thread, which then calls run() in parallel.
public class RunVsStart {

    public static void main(String[] args) throws InterruptedException {
        Thread t = new Thread(() -> System.out.println("Running on: " + Thread.currentThread().getName()));

        t.run();    // Running on: main
        t.start();  // Running on: Thread-0
        t.join();
    }
}

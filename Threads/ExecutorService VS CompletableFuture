import java.util.concurrent.CompletableFuture;
import java.util.concurrent.ExecutorService;
import java.util.concurrent.Executors;
import java.util.concurrent.Future;

// ExecutorService:   future.get() BLOCKS until the result is ready.
// CompletableFuture: chains steps that run when the result is ready (non-blocking).
public class ExecutorServiceVsCompletableFuture {

    public static void main(String[] args) throws Exception {
        withExecutor();
        withCompletableFuture();
    }

    static void withExecutor() throws Exception {
        ExecutorService pool = Executors.newSingleThreadExecutor();
        Future<Integer> future = pool.submit(() -> 10);
        System.out.println("ExecutorService: " + future.get() * 2);  // waits here
        pool.shutdown();
    }

    static void withCompletableFuture() {
        CompletableFuture.supplyAsync(() -> 10)
                .thenApply(n -> n * 2)
                .thenAccept(n -> System.out.println("CompletableFuture: " + n))
                .join();
    }
}
